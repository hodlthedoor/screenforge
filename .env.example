# ScreenForge Configuration
# Copy to .env and fill in values: cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────
# Port the API listens on
PORT=3100

# Base URL for async job poll URLs and redirects
BASE_URL=http://localhost:3100

# Environment: development | production | test
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
# Docker Compose: postgresql://screenforge:screenforge@postgres:5432/screenforge
# Local (peer auth): postgresql:///screenforge?host=/var/run/postgresql
DATABASE_URL=postgresql://screenforge:screenforge@postgres:5432/screenforge

# Redis connection (db 0 for app, db 15 reserved for tests)
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────
# Salt for hashing API keys (min 16 chars, generate with: openssl rand -hex 32)
API_KEY_SALT=

# Session secret for dashboard cookies (min 32 chars, generate with: openssl rand -hex 32)
SESSION_SECRET=

# Admin API key for /v1/keys management endpoint (optional, min 16 chars)
ADMIN_API_KEY=

# Require API key authentication for all render endpoints (default: false)
REQUIRE_AUTH=false

# Allow rendering of private/internal URLs (default: false for SSRF protection)
ALLOW_PRIVATE_URLS=false

# Comma-separated list of allowed CORS origins (e.g., https://example.com,https://app.example.com)
# Leave empty to disable CORS in production, or set to allow specific origins
CORS_ORIGINS=

# ── Rendering ─────────────────────────────────────────────────────────
# Directory for rendered screenshots/PDFs
STORAGE_PATH=./storage

# Days to retain cached files on disk (files older than this are auto-deleted)
STORAGE_RETENTION_DAYS=7

# Number of Playwright browser instances in the pool (1-20)
BROWSER_POOL_SIZE=3

# Recycle browser context after this many renders
MAX_RENDERS_PER_CONTEXT=100

# Cache TTL in seconds (0 = disabled)
CACHE_TTL_SECONDS=3600

# Navigation timeout for page.goto() in milliseconds (1000-120000)
NAVIGATION_TIMEOUT_MS=30000

# Max request body size in MB (1-100)
MAX_CONTENT_SIZE_MB=50

# ── Graceful Shutdown ─────────────────────────────────────────────────
# Timeout for graceful shutdown in milliseconds (min 1000, default 30000)
# Server will wait this long for in-flight renders to complete before forcing shutdown
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000

# Per-request timeout in milliseconds (1000-120000, default 30000)
# If a render request takes longer than this, return 504 Gateway Timeout
RENDER_TIMEOUT_MS=30000

# Circuit breaker failure threshold (min 1, default 3)
# Opens circuit after this many consecutive render failures within 60s
CIRCUIT_BREAKER_THRESHOLD=3

# ── Proxy ─────────────────────────────────────────────────────────
# Global default proxy for all render requests (optional)
# Used when rendering geo-restricted content or avoiding IP blocking
# Supports HTTP, HTTPS, SOCKS4, and SOCKS5 proxies
# Example: http://proxy.example.com:8080 or socks5://proxy.example.com:1080
PROXY_SERVER=
# Proxy authentication (optional)
PROXY_USERNAME=
PROXY_PASSWORD=

# ── Monitoring ────────────────────────────────────────────────────────
# Enable Prometheus metrics endpoint at /metrics (default: true)
METRICS_ENABLED=true

# Require API key authentication for /metrics endpoint (default: false)
# Set to true if metrics contain sensitive data or you want to restrict access
METRICS_AUTH_REQUIRED=false

# Grafana admin credentials (only used with --profile monitoring)
# Default: admin/admin (CHANGE IN PRODUCTION)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Stripe Billing ─────────────────────────────────────────────────
# Stripe secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=
# Stripe publishable key (pk_test_... or pk_live_...)
STRIPE_PUBLISHABLE_KEY=
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# ── Cloud Storage (S3-compatible) ────────────────────────────────────
# Storage backend: 'local' (default) or 's3' for S3-compatible cloud storage
# When set to 's3', rendered files are stored in an S3 bucket instead of local disk.
# Works with AWS S3, MinIO, Cloudflare R2, and other S3-compatible providers.
STORAGE_BACKEND=local
# S3 bucket name (required when STORAGE_BACKEND=s3)
S3_BUCKET=
# AWS region (required when STORAGE_BACKEND=s3; use 'auto' for Cloudflare R2)
S3_REGION=us-east-1
# AWS access key ID (required when STORAGE_BACKEND=s3)
S3_ACCESS_KEY_ID=
# AWS secret access key (required when STORAGE_BACKEND=s3)
S3_SECRET_ACCESS_KEY=
# Custom S3 endpoint for MinIO / Cloudflare R2 (optional)
# Examples: https://minio.local:9000, https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=

# ── Email (SMTP) ──────────────────────────────────────────────────────
# All SMTP fields are optional — emails silently skip if not configured
# SMTP server hostname (e.g., smtp.sendgrid.net, smtp.mailgun.org)
SMTP_HOST=
# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587
# SMTP username
SMTP_USER=
# SMTP password or API key
SMTP_PASS=
# From address for outgoing emails
SMTP_FROM=noreply@screenforge.dev

# ── AI / LLM ─────────────────────────────────────────────────────────
# Anthropic API key for AI content extraction (/v1/extract endpoint)
# Optional — extraction endpoint is disabled when not set
ANTHROPIC_API_KEY=

# ── Rate Limiting ──────────────────────────────────────────────────────
# Enable token bucket rate limiter for smoother burst handling (default: false)
# When disabled, uses sliding window rate limiter
TOKEN_BUCKET_ENABLED=false
