# ScreenForge Configuration
# Copy to .env and fill in values

# Server port
PORT=3100

# Redis connection (db 0 for app, db 15 reserved for tests)
REDIS_URL=redis://127.0.0.1:6379/0

# PostgreSQL connection (peer auth via unix socket)
DATABASE_URL=postgresql:///screenforge?host=/var/run/postgresql

# Directory for rendered screenshots/PDFs
STORAGE_PATH=./storage

# Salt for hashing API keys (min 16 chars, generate with: openssl rand -hex 32)
API_KEY_SALT=

# Browser pool settings
BROWSER_POOL_SIZE=3
MAX_RENDERS_PER_CONTEXT=100

# Cache TTL in seconds (0 = disabled, default 1 hour)
CACHE_TTL_SECONDS=3600

# Environment
NODE_ENV=development
