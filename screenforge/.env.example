# ScreenForge Configuration
# Copy to .env and fill in values: cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────
# Port the API listens on
PORT=3100

# Base URL for async job poll URLs and redirects
BASE_URL=http://localhost:3100

# Environment: development | production | test
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL connection string
# Docker Compose: postgresql://screenforge:screenforge@postgres:5432/screenforge
# Local (peer auth): postgresql:///screenforge?host=/var/run/postgresql
DATABASE_URL=postgresql://screenforge:screenforge@postgres:5432/screenforge

# Redis connection (db 0 for app, db 15 reserved for tests)
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────
# Salt for hashing API keys (min 16 chars, generate with: openssl rand -hex 32)
API_KEY_SALT=

# Session secret for dashboard cookies (min 32 chars, generate with: openssl rand -hex 32)
SESSION_SECRET=

# Admin API key for /v1/keys management endpoint (optional, min 16 chars)
ADMIN_API_KEY=

# Require API key authentication for all render endpoints (default: false)
REQUIRE_AUTH=false

# Allow rendering of private/internal URLs (default: false for SSRF protection)
ALLOW_PRIVATE_URLS=false

# ── Rendering ─────────────────────────────────────────────────────────
# Directory for rendered screenshots/PDFs
STORAGE_PATH=./storage

# Number of Playwright browser instances in the pool (1-20)
BROWSER_POOL_SIZE=3

# Recycle browser context after this many renders
MAX_RENDERS_PER_CONTEXT=100

# Cache TTL in seconds (0 = disabled)
CACHE_TTL_SECONDS=3600

# Navigation timeout for page.goto() in milliseconds (1000-120000)
NAVIGATION_TIMEOUT_MS=30000

# Max request body size in MB (1-100)
MAX_CONTENT_SIZE_MB=50

# ── Monitoring ────────────────────────────────────────────────────────
# Enable Prometheus metrics endpoint at /metrics (default: true)
METRICS_ENABLED=true

# ── Stripe Billing ─────────────────────────────────────────────────
# Stripe secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=
# Stripe publishable key (pk_test_... or pk_live_...)
STRIPE_PUBLISHABLE_KEY=
# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
