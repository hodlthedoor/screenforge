{
  "name": "@screenforge/cli",
  "version": "1.0.0",
  "description": "CLI tool for ScreenForge — take screenshots, generate PDFs, and OG cards from the terminal",
  "type": "module",
  "bin": {
    "screenforge": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hodlthedoor/screenforge.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@screenforge/sdk": "file:../../sdk/js",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
