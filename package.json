{
  "name": "screenforge",
  "version": "1.4.0",
  "description": "Self-hostable screenshot & render API — open-source alternative to ScreenshotOne",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "test:load": "tsx tests/load/benchmark.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "generate:postman": "tsx scripts/generate-postman.ts",
    "generate:sdk": "tsx scripts/generate-sdk.ts",
    "generate": "npm run generate:openapi && npm run generate:postman && npm run generate:sdk"
  },
  "keywords": [
    "screenshot",
    "render",
    "api",
    "playwright"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hodlthedoor/screenforge.git"
  },
  "homepage": "https://github.com/hodlthedoor/screenforge#readme",
  "bugs": {
    "url": "https://github.com/hodlthedoor/screenforge/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/lib-storage": "^3.1032.0",
    "@axe-core/playwright": "^4.11.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.74.1",
    "cron-parser": "^5.5.0",
    "fastify": "^5.8.5",
    "gif-encoder-2": "^1.0.5",
    "image-size": "^2.0.2",
    "ioredis": "^5.9.2",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.59.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "openapi-to-postmanv2": {
      "js-yaml": "4.1.1",
      "lodash": "4.17.23"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/pixelmatch": "^5.2.6",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^4.1.4",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.1",
    "js-yaml": "^4.1.1",
    "jsdom": "^28.0.0",
    "openapi-to-postmanv2": "^6.0.1",
    "openapi-typescript": "^7.13.0",
    "pdf-parse": "^2.4.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
